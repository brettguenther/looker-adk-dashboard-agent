# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-gcp-project-id-adk-staging
VERTEXAI_LOCATION=global

# Looker Instance & Authentication
LOOKERSDK_BASE_URL=https://your-instance.cloud.looker.com
AUTH_ID=looker-oauth
LOOKER_OAUTH_CLIENT_ID=your-looker-oauth-client-id
LOOKER_OAUTH_CLIENT_SECRET=LOOKER_DOES_NOT_USE_SECRET_IN_THIS_FLOW
LOOKERSDK_VERIFY_SSL=True

# Optional Local Developer Token Fallback (for testing offline without GE)
LOOKER_DEV_TOKEN=

# Gemini Enterprise / Agentspace Settings
AGENT_ID=looker-dashboard-agent
AGENT_DISPLAY_NAME=Looker Dashboard Architect
GE_ENGINE_ID=default_engine
REASONING_ENGINE_ID=

# LLM Model Selector
LLM_MODEL=gemini-3.6-flash

# Telemetry / Tracing Settings
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
